{
  "info": {
    "name": "Vehicle Management API",
    "description": "Postman collection for the Vehicle Management API and Commerce backend. Covers health checks, Google OAuth, refresh-token rotation, vehicle CRUD, product catalog, inventory, cart, checkout, search, recommendations, and admin ledger access.\n\n## Setup\n1. Set the base_url variable to your API host (default: http://localhost:8000)\n2. After calling Google Auth, the access_token and refresh_token variables are auto-populated from the response.\n3. All authenticated endpoints use the access_token variable in the Authorization header automatically.\n4. Commerce requests can create or reuse a product_id value saved by the collection tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicle_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "cart_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
