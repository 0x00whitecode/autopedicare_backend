{
  "info": {
    "name": "Vehicle Management API",
    "description": "Postman collection for the Vehicle Management API. Covers health checks, authentication (Google OAuth, refresh token rotation, token revocation), and full vehicle CRUD operations.\n\n## Setup\n1. Set the `base_url` variable to your API host (default: http://localhost:8000)\n2. After calling Google Auth, the `access_token` and `refresh_token` variables are auto-populated from the response.\n3. All authenticated endpoints use the `access_token` variable in the Authorization header automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicle_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          },
          "response": []
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Liveness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/live",
              "host": ["{{base_url}}"],
              "path": ["health", "live"]
            }
          },
          "response": []
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/ready",
              "host": ["{{base_url}}"],
              "path": ["health", "ready"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Google Auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.tokens && json.tokens.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.tokens.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.tokens.refresh_token);",
                  "    console.log('Tokens saved to collection variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"your-google-id-token-here\",\n  \"requested_type\": \"car_owner\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/google",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "google"]
            },
            "description": "Authenticate with a Google ID token. The `requested_type` can be either `car_owner` or `vendor`. On success, the test script automatically saves the access and refresh tokens to collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "    console.log('Rotated tokens saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Rotate the refresh token. The old token is revoked and a new token pair is returned. The test script auto-updates the collection variables."
          },
          "response": []
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/revoke",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "revoke"]
            },
            "description": "Revoke a refresh token. Returns 204 No Content on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Vehicles",
      "description": "Full CRUD for vehicle management. All endpoints require a valid access token (auto-applied via the collection-level Bearer auth).",
      "item": [
        {
          "name": "Create Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('vehicle_id', json.id);",
                  "    console.log('Vehicle ID saved: ' + json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"year\": 2021,\n  \"vin\": \"4T1BZ1HK5MU000001\",\n  \"license_plate\": \"ABC-1234\",\n  \"color\": \"Silver\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles"]
            },
            "description": "Create a new vehicle for the authenticated user. The test script saves the returned vehicle ID to the `vehicle_id` variable for use in subsequent requests."
          },
          "response": []
        },
        {
          "name": "List My Vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles?offset=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles"],
              "query": [
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "List all vehicles owned by the authenticated user. Supports pagination via `offset` and `limit` query parameters."
          },
          "response": []
        },
        {
          "name": "Get Vehicle by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles", "{{vehicle_id}}"]
            },
            "description": "Get a single vehicle by ID. Only the owner can access their vehicle; other users receive a 403."
          },
          "response": []
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color\": \"Blue\",\n  \"license_plate\": \"XYZ-5678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles", "{{vehicle_id}}"]
            },
            "description": "Partially update a vehicle. Only fields provided in the body are updated; omitted fields remain unchanged."
          },
          "response": []
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles", "{{vehicle_id}}"]
            },
            "description": "Delete a vehicle. Returns 204 No Content on success."
          },
          "response": []
        },
        {
          "name": "Get Vehicle - Not Found (404 test)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Test the 404 response when a vehicle ID does not exist."
          },
          "response": []
        },
        {
          "name": "Create Vehicle - Validation Error (422 test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"\",\n  \"model\": \"\",\n  \"year\": 1800\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles"]
            },
            "description": "Test Pydantic validation: empty make/model and year before 1886 should return 422."
          },
          "response": []
        }
      ]
    }
  ]
}
